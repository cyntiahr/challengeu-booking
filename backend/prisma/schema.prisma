
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  STUDENT
  COACH
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AvailabilityStatus {
  OPEN
  BOOKED
}

enum SessionStatus {
  BOOKED
  CANCELLED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  role      UserRole
  status    UserStatus @default(ACTIVE)
  timeZone  String     @default("UTC")
  createdAt DateTime   @default(now())

  availabilityBlocks AvailabilityBlock[] @relation("CoachAvailability")
  sessions            Session[]           @relation("StudentSessions")
  notifications      Notification[]
}

model AvailabilityBlock {
  id        String             @id @default(cuid())
  coachId   String
  startAt   DateTime
  endAt     DateTime
  status    AvailabilityStatus @default(OPEN)
  createdAt DateTime           @default(now())

  coach    User      @relation("CoachAvailability", fields: [coachId], references: [id])
  sessions Session[]

  @@index([coachId, startAt])
}

model Session {
  id                  String        @id @default(cuid())
  studentId           String
  availabilityBlockId String
  status              SessionStatus @default(BOOKED)
  createdAt           DateTime      @default(now())
  cancelledAt         DateTime?

  student           User             @relation("StudentSessions", fields: [studentId], references: [id])
  availabilityBlock AvailabilityBlock @relation(fields: [availabilityBlockId], references: [id])

  @@index([studentId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}
